{
  "name": "pokericochet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fetch-data": "tsx tools/fetch-data/index.ts",
    "typecheck": "tsc -p tsconfig.domain.json && tsc -p tsconfig.json && tsc -p tools/fetch-data/tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "bench": "vitest run --config vitest.bench.config.ts physics",
    "bench:browser": "node tools/browser-bench/run.mjs",
    "playtest": "node tools/browser-bench/playtest.mjs",
    "smoke": "node tools/browser-bench/smoke.mjs",
    "bench:agency": "vitest run --config vitest.bench.config.ts agency",
    "bench:balance": "vitest run --config vitest.bench.config.ts balance",
    "bench:run": "vitest run --config vitest.bench.config.ts run.bench"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  }
}
